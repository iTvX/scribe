# 雾凇拼音 (full pinyin) smoke test for the gate. Scripts/check-gate.sh plays
# it, in CI too, against rime-ice at its pinned release in a temporary
# directory.
@schema rime_ice
n
i
h
a
o       => marked "ni hao"; candidates "你好"
space   => commit "你好"; marked ""; candidates none
z
h
o
n
g
w
e
n       => candidates "中文"
1       => commit "中文"
s
h
u
r
u
f
a       => candidates "输入法"
Return  => commit "shurufa"
space   => unhandled

# OpenCC with the bundled data in SharedSupport/opencc: rime-ice's
# traditionalization option converts candidates with s2t.json.
@option traditionalization true
h
a
n
z
i       => candidates "漢字"
Escape  => marked ""
