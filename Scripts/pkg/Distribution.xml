<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Scribe @VERSION@</title>
    <options customize="never" hostArchitectures="arm64,x86_64" require-scripts="false" rootVolumeOnly="true"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="14.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="default">
            <line choice="io.github.itvx.inputmethod.Scribe"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="io.github.itvx.inputmethod.Scribe" visible="false">
        <pkg-ref id="io.github.itvx.inputmethod.Scribe"/>
    </choice>
    <pkg-ref id="io.github.itvx.inputmethod.Scribe" version="@VERSION@">Scribe-component.pkg</pkg-ref>
</installer-gui-script>
