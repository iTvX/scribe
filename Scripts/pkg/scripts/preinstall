#!/bin/bash
# Quits the running copy of Scribe before the installer replaces it.
# $2 is the install location, /Library/Input Methods.

executable="$2/Scribe.app/Contents/MacOS/Scribe"
[[ -x "${executable}" ]] || exit 0

console_user="$(/usr/bin/stat -f %Su /dev/console)"
if [[ -n "${console_user}" && "${console_user}" != "root" && "${console_user}" != "loginwindow" ]]; then
  /bin/launchctl asuser "$(/usr/bin/id -u "${console_user}")" \
    /usr/bin/sudo -u "${console_user}" "${executable}" --quit || true
fi

for _ in {1..50}; do
  /usr/bin/pgrep -f "${executable}" >/dev/null || exit 0
  /bin/sleep 0.1
done
/usr/bin/pkill -f "${executable}" || true
exit 0
